# AURION Key Server / Store — environment template.
# Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows CMD)

# --- Signing (the crown jewel) ------------------------------------------
# 32-byte Ed25519 seed as 64 hex chars. Only this server and the owner CLI
# (admin/mint_local.py) may ever hold it. Leave empty to mint nothing.
AURION_KEY_PRIVATE_HEX=
# Optional override of the built-in public key used for verification.
AURION_KEY_PUBLIC_HEX=

# --- Server --------------------------------------------------------------
PORT=8899
NODE_ENV=production
# Where the JSON store lives (relative to the keyserver folder).
DATA_DIR=./data
# Public base URL used for the ZarinPal callback.
PUBLIC_BASE_URL=https://keys.example.com

# --- Secrets (use long random strings) -----------------------------------
JWT_SECRET=
ADMIN_TOKEN=
# Hidden admin panel address: /#/<ADMIN_PANEL_HASH>  (letters/digits/-/_ only)
ADMIN_PANEL_HASH=owner-axia-CHANGE-THIS
ADMIN_FAIL_LIMIT=10

# --- Catalogue prices (Rial) ---------------------------------------------
PLAN_M1_PRICE=15000000
PLAN_M3_PRICE=40000000
PLAN_M6_PRICE=75000000
PLAN_Y1_PRICE=140000000

# --- Payments (ZarinPal) --------------------------------------------------
ZARINPAL_MERCHANT_ID=
# live | sandbox
ZARINPAL_GATEWAY=live
# 1 = accept payments without a real gateway. Test only. Keep 0 in production.
ALLOW_DEV_PAID=0

# --- OTP delivery ---------------------------------------------------------
# Gmail SMTP (leave empty to disable email OTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Iranian mobile OTP via Kavenegar (leave empty to disable)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
# 1 = return the OTP code in the API response. TEST ONLY — set 0 in production.
DEV_OTP_FALLBACK=0

# --- Support contact (shown in the store UI) ------------------------------
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
SUPPORT_TELEGRAM_URL=

# --- Licensing policy -----------------------------------------------------
MAX_OWNER_MACHINES=1
MAX_REPLACEMENTS=3
