{
  "name": "aurion-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "productName": "AURION",
  "description": "AURION Windows application \u2014 live MT5 desk with secure auto-installer",
  "author": "Axiasoft",
  "publisher": "Axiasoft",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win msi --x64",
    "dist": "electron-builder --win msi --x64",
    "dist:win": "electron-builder --win msi --x64",
    "dist:msi": "electron-builder --win msi --x64 --config.forceCodeSigning=false",
    "dist:msi:unsigned": "electron-builder --win msi --x64 --config.forceCodeSigning=false",
    "postinstall": "echo If winCodeSign symlink error: Enable Developer Mode + run as Admin + rmdir /s /q %LOCALAPPDATA%\\electron-builder\\Cache\\winCodeSign"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "40.0.0",
    "electron-builder": "26.0.12",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "ai.aurion.desk",
    "productName": "AURION",
    "forceCodeSigning": false,
    "directories": {
      "output": "../../dist/desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "prereq.js",
      "runtime.js",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../../backend/src",
        "to": "backend/src",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "../../engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/venv/**",
          "!**/.venv/**"
        ]
      },
      {
        "from": "../../apps/web",
        "to": "apps/web",
        "filter": [
          "**/*",
          "!**/node_modules/**"
        ]
      },
      {
        "from": "../../config",
        "to": "config",
        "filter": [
          "**/*",
          "!aurion.json",
          "!news_calendar.csv",
          "!news_calendar.fetched",
          "!owner.gmail",
          "!telegram.token"
        ]
      },
      {
        "from": "../../lang",
        "to": "lang",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../windows-app/installer",
        "to": "windows-app/installer",
        "filter": [
          "install-windows.ps1"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "AURION",
      "runAfterFinish": true,
      "warningsAsErrors": false
    }
  }
}
