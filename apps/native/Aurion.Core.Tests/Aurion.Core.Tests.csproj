<Project Sdk="Microsoft.NET.Sdk">

  <!-- The money rules are not tested against hand-written expectations
       here. They are tested against tests/fixtures/*.json - the SAME
       files the Python engine and the JavaScript desk are tested
       against. That is the whole point: a fixture case is the rule, and
       all three implementations answer to it. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Aurion.Core.Tests</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aurion.Core\Aurion.Core.csproj" />
  </ItemGroup>

</Project>
