# ---------------------------------------------------------------------------
# Installer build artefacts
# ---------------------------------------------------------------------------
installer/stage/
installer/output/
installer/bin/
installer/obj/
*.binlog
*.wixpdb

# ---------------------------------------------------------------------------
# Runtime / build junk
# ---------------------------------------------------------------------------
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# WebView2 desk window build output
installer/window/bin/
installer/window/obj/

# local UI scratch pages (never shipped)
apps/web/__*.html

# JS analysis helper deps (installed on demand, never shipped)
node_modules/

# local dev virtualenv + engine day state
.venv_dev/
data/prop-day.json

# The build script keeps the artwork it repacked, next to the icon it made.
installer/assets/generated/*.original.png
installer/assets/generated/*.original.ico
