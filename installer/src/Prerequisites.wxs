<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <?include Variables.wxi ?>

  <!--
    Environment detection.

    AURION runs on CPython 3.10-3.12 and Node.js 18+. On a bare machine setup
    now *provisions* them rather than leaving the user a reading exercise:
    AURION.exe, started with the setup switch, downloads the vendors' own
    installers, checks the Authenticode publisher before running anything, and
    installs what is missing (see installer\window\Prerequisites.cs).
    AurionProvisionRuntimes in Actions.wxs is what starts it.

    Two things are deliberately NOT done:
      * nothing is bundled into the MSI - a packaged runtime would collide
        with the ones traders already have, and would go stale on our release
        cadence rather than the vendors';
      * nothing is installed from inside the MSI transaction - Node.js ships
        as an .msi, and Windows Installer's _MSIExecute mutex forbids a nested
        install. Provisioning therefore runs as a separate process once this
        transaction is over.

    What lives in this file is only the *detection* half, and only so the
    wizard can tell the user in advance what it is about to do. Everything
    here is a plain AppSearch (registry / directory search) with no custom
    action, so it is also correct during a silent install. It is a cheap
    approximation: the authoritative check is the one Prerequisites.cs makes
    by actually running `python -V` and `node -v` on the PATH the desk will
    use.
  -->
  <Fragment>

    <!-- ================================================================ -->
    <!-- Python 3.12 / 3.11 / 3.10, per-user and per-machine, 64-bit first -->
    <!-- ================================================================ -->
    <Property Id="AURION_PYTHON312" Secure="yes">
      <RegistrySearch Id="Py312User" Root="HKCU" Key="Software\Python\PythonCore\3.12\InstallPath" Type="raw" Bitness="always64" />
      <RegistrySearch Id="Py312Machine" Root="HKLM" Key="Software\Python\PythonCore\3.12\InstallPath" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="AURION_PYTHON311" Secure="yes">
      <RegistrySearch Id="Py311User" Root="HKCU" Key="Software\Python\PythonCore\3.11\InstallPath" Type="raw" Bitness="always64" />
      <RegistrySearch Id="Py311Machine" Root="HKLM" Key="Software\Python\PythonCore\3.11\InstallPath" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="AURION_PYTHON310" Secure="yes">
      <RegistrySearch Id="Py310User" Root="HKCU" Key="Software\Python\PythonCore\3.10\InstallPath" Type="raw" Bitness="always64" />
      <RegistrySearch Id="Py310Machine" Root="HKLM" Key="Software\Python\PythonCore\3.10\InstallPath" Type="raw" Bitness="always64" />
    </Property>

    <!-- 3.13+ is actively unsupported: engine\main.py refuses to start on it and
         numpy 1.26.4 has no wheels for it. Detected so the wizard can say so
         instead of letting the user discover it at first launch. -->
    <Property Id="AURION_PYTHON_UNSUPPORTED" Secure="yes">
      <RegistrySearch Id="Py313User" Root="HKCU" Key="Software\Python\PythonCore\3.13\InstallPath" Type="raw" Bitness="always64" />
      <RegistrySearch Id="Py313Machine" Root="HKLM" Key="Software\Python\PythonCore\3.13\InstallPath" Type="raw" Bitness="always64" />
    </Property>

    <SetProperty Id="AURION_PYTHON_OK" Action="AurionSetPythonOk" Value="1"
                 After="AppSearch" Sequence="both"
                 Condition="AURION_PYTHON312 OR AURION_PYTHON311 OR AURION_PYTHON310" />

    <!-- ================================================================ -->
    <!-- Node.js                                                          -->
    <!-- ================================================================ -->
    <!-- The HKLM\Software\Node.js\InstallPath key that Node's own MSI writes is
         deliberately NOT used. It records *a* Node, with no version anywhere
         near it, so it answers "found" just as cheerfully for the Node 16 that
         AURION cannot run. A false "found" clears the wizard and hands the user
         a failure at first launch - exactly the bug this page exists to
         prevent - whereas a false "not found" costs nothing: provisioning asks
         `node -v` itself, sees a good runtime, and installs nothing.
         node.exe carries a version resource, so the default install location
         can be checked properly instead of merely being found. -->
    <Property Id="AURION_NODE_FILE" Secure="yes">
      <DirectorySearch Id="NodeDirSearch" Path="[ProgramFiles64Folder]nodejs">
        <FileSearch Id="NodeExeSearch" Name="node.exe" MinVersion="18.0.0.0" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="AURION_NODE_OK" Action="AurionSetNodeOk" Value="1"
                 After="AppSearch" Sequence="both"
                 Condition="AURION_NODE_FILE" />

    <!-- ================================================================ -->
    <!-- Is there anything for setup to provision?                        -->
    <!-- ================================================================ -->
    <!-- Set after the two OK flags above, which is why Before/After order
         matters: AurionSetPythonOk and AurionSetNodeOk both sit immediately
         after AppSearch, so this one has to come after them, not after
         AppSearch, or it would read properties that are not written yet.
         MT5 is excluded on purpose - it usually lives on a separate VPS, so
         its absence is never something to act on. -->
    <!-- The escape hatch, for administrators who image the runtimes themselves:
         msiexec /i AURION-1.0.0-x64.msi /qn AURION_SKIP_PROVISION=1 -->
    <Property Id="AURION_SKIP_PROVISION" Value="0" Secure="yes" />

    <SetProperty Id="AURION_PROVISION_NEEDED" Action="AurionSetProvisionNeeded" Value="1"
                 After="AurionSetNodeOk" Sequence="both"
                 Condition="NOT AURION_PYTHON_OK OR NOT AURION_NODE_OK" />

    <!-- ================================================================ -->
    <!-- MetaTrader 5 terminal (informational only - it is usually on a    -->
    <!-- separate VPS, so its absence is never an error)                   -->
    <!-- ================================================================ -->
    <Property Id="AURION_MT5" Secure="yes">
      <DirectorySearch Id="Mt5CommonSearch" Path="[AppDataFolder]MetaQuotes\Terminal\Common\Files" />
    </Property>
    <SetProperty Id="AURION_MT5_OK" Value="1" After="AppSearch" Sequence="both" Condition="AURION_MT5" />

    <!-- ================================================================ -->
    <!-- Previous AURION install: version + location, for the welcome page -->
    <!-- ================================================================ -->
    <Property Id="AURION_INSTALLED_VERSION" Secure="yes">
      <RegistrySearch Id="PrevVersion" Root="$(var.RegRoot)" Key="$(var.RegKey)" Name="Version" Type="raw" />
    </Property>
    <Property Id="AURION_INSTALLED_FOLDER" Secure="yes">
      <RegistrySearch Id="PrevFolder" Root="$(var.RegRoot)" Key="$(var.RegKey)" Name="InstallFolder" Type="directory" />
    </Property>

    <!-- Remembered wizard choices. Defaults: Start Menu yes, Desktop no. -->
    <Property Id="AURION_WANT_STARTMENU" Value="1" Secure="yes">
      <RegistrySearch Id="PrevWantStartMenu" Root="$(var.RegRoot)" Key="$(var.RegKey)" Name="WantStartMenu" Type="raw" />
    </Property>
    <Property Id="AURION_WANT_DESKTOP" Value="0" Secure="yes">
      <RegistrySearch Id="PrevWantDesktop" Root="$(var.RegRoot)" Key="$(var.RegKey)" Name="WantDesktop" Type="raw" />
    </Property>

    <!-- Re-install into the previous location by default, so an upgrade never
         silently moves a desk that the user put on D:\aurion. -->
    <SetProperty Id="INSTALLFOLDER" Value="[AURION_INSTALLED_FOLDER]"
                 After="AppSearch" Sequence="both"
                 Condition="AURION_INSTALLED_FOLDER AND NOT INSTALLFOLDER_SET" />

  </Fragment>
</Wix>
