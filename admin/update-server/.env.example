# AURION Update Server — environment template.
# Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows CMD)

PORT=8898
NODE_ENV=production

# Admin API token — long random string. Required: without it every /admin
# request is rejected with 401.
ADMIN_TOKEN=

# Hidden admin panel address: /admin/<ADMIN_PANEL_HASH>
ADMIN_PANEL_HASH=aurion-update-admin-CHANGE-THIS

# Where update payloads and metadata are stored (0600/0700).
DATA_DIR=./data

# Comma separated CORS allow-list for the desk client.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,app://aurion
